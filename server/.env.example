# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file to Git — it holds live cloud database
# credentials. It is already excluded via .gitignore.

# Port the API server listens on
PORT=4000

# --- Cloud PostgreSQL (Neon) -------------------------------------------
# Create a free project at https://neon.tech, then copy the two connection
# strings it gives you (Dashboard -> your project -> Connect):
#
#   DATABASE_URL  = the POOLED connection string (host ends in "-pooler"),
#                   used by the running app for normal queries.
#   DIRECT_URL    = the UNPOOLED / direct connection string (no "-pooler"),
#                   used only by Prisma to run migrations (CREATE TABLE etc).
#
# Both must end in "?sslmode=require" — Neon requires TLS for every
# connection; never disable this. The pooled URL additionally needs
# "&pgbouncer=true" so Prisma disables named prepared statements, which
# PgBouncer's transaction-pooling mode does not support across requests.
#
# Example shape (replace with your own project's values):
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-12345-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-12345.us-east-2.aws.neon.tech/dbname?sslmode=require"
# -------------------------------------------------------------------------

# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string

NODE_ENV=development

# Origin the frontend is served from (for CORS + cookie settings).
CLIENT_ORIGIN=http://localhost:5173

# Session/auto-lock behaviour
SESSION_MAX_AGE_MINUTES=480
