{
  "name": "dental-clinic-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Dr. Malek Abu Sholdom's Dental Clinic Management System",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node src/scripts/seed.js",
    "create-admin": "node src/scripts/createAdmin.js",
    "backup": "node src/scripts/backup.js",
    "restore": "node src/scripts/restore.js",
    "migrate-from-sqlite": "node src/scripts/migrateFromSqlite.js",
    "test": "node --test src/tests"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "better-sqlite3": "^11.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.20.0"
  }
}
