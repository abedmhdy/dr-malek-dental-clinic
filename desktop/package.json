{
  "name": "dr-malek-dental-clinic-desktop",
  "version": "1.1.1",
  "private": true,
  "description": "Desktop application for Dr. Malek Abu Sholdom's Dental Clinic Management System",
  "main": "main.js",
  "scripts": {
    "make-icon": "node scripts/make-icon.js",
    "prepare-resources": "node scripts/prepare-resources.js",
    "start": "electron .",
    "dist": "npm run prepare-resources && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^44.1.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.35.4"
  },
  "build": {
    "appId": "com.drmalek.dentalclinic",
    "productName": "Dr. Malek Dental Clinic",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html"
    ],
    "extraResources": [
      {
        "from": "resources/server",
        "to": "server",
        "filter": ["**/*"]
      },
      {
        "from": "resources/client-dist",
        "to": "client-dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "shortcutName": "Dr. Malek Dental Clinic",
      "artifactName": "DrMalekDentalClinic-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DrMalekDentalClinic-Portable-${version}.${ext}"
    }
  }
}
